# ProcuraFlow configuration. Copy to `.env` (never commit the copy) and edit.
#
#   Local development : copy to backend/.env (pydantic reads `.env` from the directory the backend runs in).
#   Docker Compose    : copy to the repository root as `.env` (deploy/docker-compose.yml reads it).
#
# Every value below is a safe placeholder, not a working secret.
#
# SECRET RULES (enforced in code, backend/app/core/config.py and backend/app/seeds/seed.py)
#   * ENVIRONMENT=production or staging refuses to start when JWT_SECRET_KEY is a known placeholder, contains a
#     placeholder marker (such as "change-me" or "insecure"), is shorter than 32 characters or has fewer than 10
#     different characters.
#   * Outside development/test the database password (in DATABASE_URL and MIGRATION_DATABASE_URL) must exist, be at
#     least 8 characters and not be a common default ("procuraflow", "postgres", "password", "admin", ...).
#   * Outside development/test the seed refuses a DEFAULT_ADMIN_PASSWORD that is a known default or shorter
#     than 12 characters.
#   * DEMO_MODE=true together with ENVIRONMENT=production is refused unless ALLOW_DEMO_IN_PRODUCTION=true.
#   * Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
#   * Never put real secrets in this file, in a commit, in an image or in a screenshot.

# ---------------------------------------------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------------------------------------------

# development | test | staging | production. The code default is "production" (the safe one), so a deployment that
# forgets this line is strict, not lax. Use "development" only on your own machine.
ENVIRONMENT=development

# Verbose error output. Keep false anywhere other people can reach.
DEBUG=false

# ---------------------------------------------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------------------------------------------

# Async SQLAlchemy URL. Plain postgresql:// or postgres:// URLs (as hosting providers give them) are rewritten
# for asyncpg automatically. Use 127.0.0.1 rather than localhost on Windows (localhost can cost seconds per connection).
# Docker Compose ignores this value and builds the URL from POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB below.
DATABASE_URL=postgresql+asyncpg://procuraflow:procuraflow@127.0.0.1:5432/procuraflow

# Used only by the backend test suite. It must be a separate, disposable database: tests create and drop tables.
TEST_DATABASE_URL=postgresql+asyncpg://procuraflow:procuraflow@127.0.0.1:5432/procuraflow_test

# Optional direct (non-pooler) connection used only by migrations. Needed behind a transaction-pooling PgBouncer
# (for example Neon's -pooler host). Leave empty to use DATABASE_URL.
MIGRATION_DATABASE_URL=

# ---------------------------------------------------------------------------------------------------------------
# Authentication and sessions
# ---------------------------------------------------------------------------------------------------------------

# REQUIRED. Signing key for access and refresh tokens. This placeholder is deliberately too short for production.
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Hard ceiling on a session however actively it is refreshed (minimum 1).
SESSION_ABSOLUTE_DAYS=30
# A refresh token seen again this soon after use is treated as a double submit, not theft.
REFRESH_REUSE_GRACE_SECONDS=10

# Sign-in throttling: failures tolerated per account and per client address within the lockout window.
LOGIN_MAX_FAILURES_PER_ACCOUNT=5
LOGIN_MAX_FAILURES_PER_IP=20
LOGIN_LOCKOUT_SECONDS=900

# ---------------------------------------------------------------------------------------------------------------
# Reverse proxy and CORS
# ---------------------------------------------------------------------------------------------------------------

# How many reverse proxies sit in front of the API and are trusted for the client address (0 to 5).
# 0 ignores X-Forwarded-* (local development, direct exposure). The Docker Compose setup with Caddy uses 1 and
# sets it itself. A wrong value never trusts a spoofed address; it only weakens the per-address throttle.
TRUSTED_PROXY_HOPS=0

# Comma-separated allowed browser origins. Unset means local dev origins in development/test and NO cross-origin
# access elsewhere, which is correct when the browser reaches the API through the same-origin /api proxy.
# CORS_ORIGINS=https://procure.example.com

# ---------------------------------------------------------------------------------------------------------------
# First administrator (created by the seed; both rules above apply outside development/test)
# ---------------------------------------------------------------------------------------------------------------

DEFAULT_ADMIN_EMAIL=admin@example.com
# Placeholder. Replace with a unique password of at least 12 characters before any non-local start.
DEFAULT_ADMIN_PASSWORD=change-this-admin-password

# ---------------------------------------------------------------------------------------------------------------
# File storage (logo, attachments, supplier documents)
# ---------------------------------------------------------------------------------------------------------------

# local | s3
STORAGE_BACKEND=local
# Used when STORAGE_BACKEND=local. Relative paths resolve from the backend directory. Containers mount a volume here.
STORAGE_LOCAL_PATH=var/uploads

# Used only when STORAGE_BACKEND=s3 (any S3-compatible service). All five are then required, or startup fails.
# S3_ENDPOINT_URL must start with https:// (http:// is accepted for a local MinIO).
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------------------------------------------

# Without SMTP_HOST, messages are written to the outbox and logged, not sent (always the case in development/test).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
EMAIL_FROM=ProcuraFlow <no-reply@procuraflow.local>
# Public base URL of the web app, used for links in emails (password reset, invitations).
APP_BASE_URL=http://localhost:5173
# Delivery attempts per queued message before it is left as failed (minimum 1).
EMAIL_MAX_ATTEMPTS=5

# ---------------------------------------------------------------------------------------------------------------
# Demo data and demo mode
# ---------------------------------------------------------------------------------------------------------------

# Sample suppliers and products. Unset: seeded in development/test, not in staging/production.
# Set true only for a public demo; a real installation never needs it.
# SEED_DEMO_DATA=false

# Public demo: one-click role sign-in WITHOUT a password, destructive admin actions blocked, email logged only.
# NEVER enable it on an installation that holds real data. In production it is refused unless
# ALLOW_DEMO_IN_PRODUCTION=true is set as well, which only a deliberate public demo deployment should do.
# DEMO_MODE=false
# ALLOW_DEMO_IN_PRODUCTION=false
# Password of the seeded demo accounts (at least 12 characters). Unset: derived from JWT_SECRET_KEY, so each
# deployment has its own. Demo accounts only sign in while DEMO_MODE is true.
# DEMO_PASSWORD=

# ---------------------------------------------------------------------------------------------------------------
# Production container only (backend/start.sh and the host)
# ---------------------------------------------------------------------------------------------------------------

# Listen port inside the container (hosts such as Render set this). Default 8000.
# PORT=8000
# Run `alembic upgrade head` when the container starts. Set false only if you migrate as a separate step.
# RUN_MIGRATIONS_ON_START=true
# Create roles, permissions and the first admin when the container starts. Idempotent.
# SEED_ON_START=true

# ---------------------------------------------------------------------------------------------------------------
# Frontend (build time; Vite bakes VITE_* values into the bundle)
# ---------------------------------------------------------------------------------------------------------------

# Base URL of the API for the dev server. Production builds leave it unset and use same-origin /api/v1, which is
# what both the Caddy and the Vercel setups provide. Put this line in frontend/.env, not in the backend .env.
# VITE_API_BASE_URL=http://localhost:8000/api/v1

# ---------------------------------------------------------------------------------------------------------------
# Docker Compose deployment (deploy/docker-compose.yml, deploy/backup.sh). Ignored by the backend itself.
# ---------------------------------------------------------------------------------------------------------------

# Database container credentials. The backend URL is built from these. Use letters and digits only for the
# password (a hex string from `openssl rand -hex 24` is fine) so it needs no URL escaping. The API refuses to start
# in production with a default or short password (see the secret rules at the top); this placeholder is refused.
POSTGRES_USER=procuraflow
POSTGRES_DB=procuraflow
POSTGRES_PASSWORD=change-me

# Public host name Caddy serves and obtains a certificate for, for example procure.example.com.
# Its DNS A/AAAA record must already point at the server and ports 80 and 443 must be reachable.
# Use "localhost" to try the stack locally with Caddy's own internal certificate.
SITE_ADDRESS=localhost
# Contact address Let's Encrypt may use for expiry notices.
ACME_EMAIL=admin@example.com

# Backups written by deploy/backup.sh are deleted after this many days.
BACKUP_RETENTION_DAYS=14
