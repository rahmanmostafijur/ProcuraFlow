ENVIRONMENT=development
DEBUG=true

DATABASE_URL=postgresql+asyncpg://procuraflow:procuraflow@127.0.0.1:5433/procuraflow
TEST_DATABASE_URL=postgresql+asyncpg://procuraflow:procuraflow@127.0.0.1:5433/procuraflow_test
# Provider URLs work as-is (postgresql://...?sslmode=require is rewritten for asyncpg). For Neon, use the
# direct (non "-pooler") host for migrations if you can; a "-pooler" host is detected and handled too.

# Required outside development/test: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-this-to-a-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Optional. Unset: localhost dev origins in development/test, none in staging/production
# (a frontend served through the same-origin /api proxy needs no CORS).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

DEFAULT_ADMIN_EMAIL=admin@procuraflow.com
DEFAULT_ADMIN_PASSWORD=change-this-admin-password

# Production container only (start.sh): set to false to skip seeding on boot.
# SEED_ON_START=true
