# Caddy serves the built frontend, proxies /api to the backend and gets a certificate automatically.
# SITE_ADDRESS and ACME_EMAIL come from the environment (see deploy/docker-compose.yml).
#
# SITE_ADDRESS=procure.example.com  -> HTTPS with a Let's Encrypt certificate, HTTP redirected to HTTPS.
# SITE_ADDRESS=localhost            -> HTTPS with Caddy's own local CA (browsers will warn).
# SITE_ADDRESS=:80                  -> plain HTTP only. Do not use outside a private test.

{
	email {$ACME_EMAIL}
}

{$SITE_ADDRESS} {
	encode zstd gzip

	# Same policy as frontend/vercel.json: scripts and styles only from this origin, every API call same-origin.
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		-Server
	}

	# Only /api/* is forwarded (/api/health, /api/ready, /api/v1/*). The backend's bare /health, /docs and
	# /openapi.json are therefore not reachable from outside.
	handle /api/* {
		# Caddy sets X-Forwarded-For (one entry: the client) and X-Forwarded-Proto itself, which is what
		# TRUSTED_PROXY_HOPS=1 expects. Uploads can be large: allow generous time and body size.
		request_body {
			max_size 25MB
		}
		reverse_proxy backend:8000 {
			health_uri /health
			health_interval 15s
			transport http {
				response_header_timeout 120s
			}
		}
	}

	handle {
		root * /srv
		# Fingerprinted build assets never change under the same name.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		# index.html must always be revalidated so a new release is picked up.
		@index not path /assets/*
		header @index Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
